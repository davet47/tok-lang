// Standard library: @"str" module tests

s=@"str"

// --- upper/lower ---
pl(s.upper("hello"))
// expect: HELLO
pl(s.lower("WORLD"))
// expect: world

// --- trim ---
pl(s.trim("  hello  "))
// expect: hello
pl("["+s.trim_left("  hello  ")+"]")
// expect: [hello  ]
pl("["+s.trim_right("  hello  ")+"]")
// expect: [  hello]

// --- contains ---
pl(s.contains("hello world" "world"))
// expect: T
pl(s.contains("hello" "xyz"))
// expect: F

// --- starts_with / ends_with ---
pl(s.starts_with("hello" "hel"))
// expect: T
pl(s.ends_with("hello" "llo"))
// expect: T
pl(s.starts_with("hello" "xyz"))
// expect: F

// --- index_of ---
pl(s.index_of("hello" "ll"))
// expect: 2
pl(s.index_of("hello" "xyz"))
// expect: -1

// --- replace ---
pl(s.replace("hello world" "world" "tok"))
// expect: hello tok

// --- repeat ---
pl(s.repeat("ab" 3))
// expect: ababab

// --- split ---
pl(s.split("a,b,c" ","))
// expect: [a b c]

// --- chars ---
pl(s.chars("hi"))
// expect: [h i]

// --- rev ---
pl(s.rev("hello"))
// expect: olleh

// --- len ---
pl(s.len("hello"))
// expect: 5

// --- substr ---
pl(s.substr("hello world" 0 5))
// expect: hello
pl(s.substr("hello world" 6 11))
// expect: world

// --- pad ---
pl(s.pad_left("42" 5 "0"))
// expect: 00042
pl(s.pad_right("hi" 5 "."))
// expect: hi...

// --- bytes ---
b=s.bytes("A")
pl(b[0])
// expect: 65
