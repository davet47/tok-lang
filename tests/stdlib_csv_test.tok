// stdlib_csv_test.tok -- CSV module tests
//
// Compile & run:   cargo run -- run tests/stdlib_csv_test.tok

c=@"csv"

pl("=== CSV Parse Tests ===")
// expect: === CSV Parse Tests ===

// --- Basic parse: headers + rows ---
data=c.cparse("name,age,city\nAlice,30,NYC\nBob,25,LA")
pl(#data)
// expect: 2
pl(data[0].name)
// expect: Alice
pl(data[0].age)
// expect: 30
pl(data[0].city)
// expect: NYC
pl(data[1].name)
// expect: Bob
pl(data[1].age)
// expect: 25
pl(data[1].city)
// expect: LA

// --- Numeric auto-detection ---
nums=c.cparse("x,y\n1,2.5\n-3,0.0")
pl(nums[0].x)
// expect: 1
pl(nums[0].y)
// expect: 2.5
pl(nums[1].x)
// expect: -3

// --- Empty fields become nil ---
sparse=c.cparse("a,b,c\n1,,3\n,,")
pl(sparse[0].a)
// expect: 1
pl(sparse[0].b)
// expect: N
pl(sparse[0].c)
// expect: 3
pl(sparse[1].a)
// expect: N

// --- Quoted fields with commas ---
quoted=c.cparse("name,desc\nAlice,\"hello, world\"\nBob,simple")
pl(quoted[0].desc)
// expect: hello, world
pl(quoted[1].desc)
// expect: simple

// --- Quoted fields with escaped quotes ---
esc=c.cparse("msg\n\"She said \"\"hi\"\"\"")
pl(esc[0].msg)
// expect: She said "hi"

// --- Fewer fields than headers ---
short=c.cparse("a,b,c\n1,2")
pl(short[0].a)
// expect: 1
pl(short[0].b)
// expect: 2
pl(short[0].c)
// expect: N

// --- Empty input ---
empty=c.cparse("")
pl(#empty)
// expect: 0

// --- Single column ---
single=c.cparse("id\n1\n2\n3")
pl(#single)
// expect: 3
pl(single[2].id)
// expect: 3

pl("")
// expect:
//
pl("=== CSV Stringify Tests ===")
// expect: === CSV Stringify Tests ===

// --- Basic encode ---
rows=[{name:"Alice" age:30} {name:"Bob" age:25}]
out=c.cstr(rows)
pl(out)
// expect:
// name,age
// Alice,30
// Bob,25

// --- Fields needing quoting ---
special=[{msg:"hello, world"} {msg:"normal"}]
sout=c.cstr(special)
pl(sout)
// expect:
// msg
// "hello, world"
// normal

// --- Roundtrip ---
pl("")
// expect:
//
pl("=== Roundtrip Test ===")
// expect: === Roundtrip Test ===
csv_text="name,score\nAlice,95\nBob,87\nCarol,92"
parsed=c.cparse(csv_text)
encoded=c.cstr(parsed)
reparsed=c.cparse(encoded)
pl(#reparsed)
// expect: 3
pl(reparsed[0].name)
// expect: Alice
pl(reparsed[0].score)
// expect: 95
pl(reparsed[2].name)
// expect: Carol
pl(reparsed[2].score)
// expect: 92
