# Variables and arithmetic
x=10
y=20
pl(x+y)
// expect: 30
pl(x*y)
// expect: 200
pl(x-y)
// expect: -10

# Function definition and call
f add(a:i b:i):i=a+b
pl(add(3 4))
// expect: 7

# Recursion
f fib(n:i):i=n<2?n:fib(n-1)+fib(n-2)
pl(fib(10))
// expect: 55

# Boolean
pl(T)
// expect: T
pl(F)
// expect: F
pl(1==1)
// expect: T
pl(1<2)
// expect: T

# String operations
s="Hello"
pl(s)
// expect: Hello

# Conditional (ternary)
pl(10>5?"yes":"no")
// expect: yes

# Loop
~(i:1..6){pl(i)}
// expect: 1
// expect: 2
// expect: 3
// expect: 4
// expect: 5
