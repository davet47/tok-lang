# Standard library: @"re" module tests

re=@"re"

# --- rmatch ---
pl(re.rmatch("hello world" "hello"))
// expect: T
pl(re.rmatch("hello world" "^world"))
// expect: F
pl(re.rmatch("abc123" "[0-9]+"))
// expect: T

# --- rfind ---
pl(re.rfind("abc 123 def 456" "[0-9]+"))
// expect: 123
pl(re.rfind("no digits here" "[0-9]+"))
// expect: N

# --- rall ---
pl(re.rall("abc 123 def 456" "[0-9]+"))
// expect: [123 456]
pl(re.rall("no match" "[0-9]+"))
// expect: []

# --- rsub ---
pl(re.rsub("hello 123 world 456" "[0-9]+" "NUM"))
// expect: hello NUM world NUM
pl(re.rsub("no match" "[0-9]+" "NUM"))
// expect: no match
